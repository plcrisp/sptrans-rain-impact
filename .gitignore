# Virtual environments
venv/
env/
.env/
.venv/

# Environment files
.env
.env.local
.env.development
!.env.example

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# IDE configs & swap files
.vscode/
.idea/
*.swp
*.swo

# Data directory: ignore all contents, keep directory structure via .gitkeep
data/**
!data/**/
!.gitkeep
# Exceções de dados essenciais versionados: necessários para a VM de coleta da Task 2 via git clone
!data/bronze/lines/selected_lines.json
!data/bronze/lines/line_station_mapping.parquet

# Logs directory: ignore log files, keep directory structure via .gitkeep
logs/**
!logs/**/
!.gitkeep
*.log