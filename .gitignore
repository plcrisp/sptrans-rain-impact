# Virtual environments
venv/
env/
.env/
.venv/

# Environment files
.env
.env.local
.env.development
!.env.example

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# IDE configs & swap files
.vscode/
.idea/
*.swp
*.swo

# Data directory: ignore all contents, keep directory structure via .gitkeep
data/**
!data/**/
!.gitkeep
# Caso arquivos de dados pequenos precisem ser versionados no futuro (ex.: data/bronze/selected_lines.json),
# descomente a regra abaixo em vez de alterar a regra geral:
# !data/bronze/selected_lines.json

# Logs directory: ignore log files, keep directory structure via .gitkeep
logs/**
!logs/**/
!.gitkeep
*.log