# Virtual environments
venv/
env/
.env/
.venv/

# Environment files
.env
.env.local
.env.development
!.env.example

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# IDE configs & swap files
.vscode/
.idea/
*.swp
*.swo

# Data directory: ignore all contents, keep directory structure via .gitkeep
data/**
!data/**/
!.gitkeep
# Exceções de dados essenciais versionados: entrada GTFS e linhas selecionadas
!data/reference/gtfs/gtfs.zip
!data/reference/lines/selected_lines.json
!data/reference/lines/line_station_mapping.parquet
!data/reference/lines/line_ranking.csv

*.log