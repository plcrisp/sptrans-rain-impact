# Credenciais das APIs (defina no seu arquivo .env local, nunca versione dados sensíveis)
SPTRANS_TOKEN=your_sptrans_token_here
CEMADEN_EMAIL=your_cemaden_email_here
CEMADEN_PASSWORD=your_cemaden_password_here

# Configurações da API Olho Vivo (SPTrans)
SPTRANS_BASE_URL=http://api.olhovivo.sptrans.com.br/v2.1
COLLECTION_INTERVAL_SECONDS=60
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_SECONDS=2

# URLs da API do CEMADEN
CEMADEN_AUTH_URL=cemaden_auth_url
CEMADEN_SCHEDULE_URL=cemaden_schedule_url
CEMADEN_STATION_URL=cemaden_station_url
CEMADEN_STATUS_URL=cemaden_status_url
CEMADEN_NETWORK_ID=11
CEMADEN_SENSOR_ID=10
CEMADEN_POLL_INTERVAL_SECONDS=20
CEMADEN_JOB_TIMEOUT_SECONDS=1800
CEMADEN_MAX_PENDING_JOBS=5
RAIN_MAX_MM_PER_INTERVAL=150.0

# Configuração de Logs
LOG_LEVEL=INFO
