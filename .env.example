# Credenciais das APIs (defina no seu arquivo .env local, nunca versione dados sensíveis)
SPTRANS_TOKEN=your_sptrans_token_here
CEMADEN_USER=your_cemaden_email_here
CEMADEN_PASSWORD=your_cemaden_password_here

# Configurações da API Olho Vivo (SPTrans)
SPTRANS_BASE_URL=http://api.olhovivo.sptrans.com.br/v2.1
COLLECTION_INTERVAL_SECONDS=60
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_SECONDS=2

# Configuração de Logs
LOG_LEVEL=INFO
